// ================================================================
// Multi-tenant 3D/AR Product Showcase Platform — Database Schema
// Phase 1: full model, ready for SQLite (local dev) or Postgres (prod)
// Switch datasource.provider to "postgresql" and set DATABASE_URL
// to a Postgres connection string for production.
// ================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------
// SQLite-compatible scalar representations
// ----------------------------------------------------------------
// Prisma SQLite does not support native enum or Json fields. The application
// layer owns these string values and validates them with TypeScript/Zod.

// ----------------------------------------------------------------
// Core identity
// ----------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // A SELLER user has exactly one seller profile; ADMIN/SUPER_ADMIN do not.
  seller Seller?

  sessions        Session[]
  auditLogsActor  AuditLog[]         @relation("AuditActor")
  subscriptionsBy Subscription[]     @relation("ActivatedByAdmin")
  approvedTrafficPurchases TrafficPurchase[] @relation("TrafficPurchaseApprovedBy")
  publishJobs     PublishJob[]       @relation("TriggeredByUser")
  loginAttempts   LoginAttempt[]

  @@index([role])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  success   Boolean
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

// ----------------------------------------------------------------
// Tenant: Seller
// ----------------------------------------------------------------

model Seller {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  slug         String   @unique
  storeName    String
  description  String?
  logoUrl      String?
  // Canonical storage key for the seller logo; avoids relying on provider/CDN URLs.
  logoStorageKey String?
  themeColor   String?
  contactEmail String?
  contactPhone String?
  address      String?
  sellerCategoryId String?
  sellerCategory   Category? @relation("SellerCategory", fields: [sellerCategoryId], references: [id], onDelete: SetNull)
  socialLinks  String?   // JSON-serialized object

  isActive     Boolean  @default(true) // admin can hard-disable regardless of subscription

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  products         Product[]
  subscriptions    Subscription[]
  publishJobs      PublishJob[]
  analyticsEvents  AnalyticsEvent[]
  trafficUsages    TrafficUsage[]
  trafficPurchases TrafficPurchase[]
  auditLogs        AuditLog[]       @relation("AuditSeller")

  @@index([slug])
  @@index([sellerCategoryId])
}

// ----------------------------------------------------------------
// Catalog
// ----------------------------------------------------------------

model Category {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String

  // Super Admin can temporarily disable a category
  // without deleting products assigned to it.
  isActive  Boolean  @default(true)

  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")

  products  Product[]
  sellers   Seller[]  @relation("SellerCategory")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@index([isActive])
}

model Product {
  id          String            @id @default(cuid())
  sellerId    String
  seller      Seller            @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  slug        String            @unique
  name        String
  shortDescription String?
  fullDescription  String?
  price         Float?
  isPinned      Boolean           @default(false)
  pinOrder      Int?

  categoryId  String?
  category    Category?         @relation(fields: [categoryId], references: [id])
  tags        String?           // comma-separated; normalized in service layer
  material    String?           // product material / جنس متریال
  colors      String?           // JSON-serialized color labels / hex values

  // Real-world dimensions, normalized internally to millimeters
  // (see utils/dimensions.ts)
  widthMm     Float?
  heightMm    Float?
  depthMm     Float?
  inputUnit   String?           // MM | CM | M

  visibility  String            @default("DRAFT")

  // Denotes the currently PUBLISHED snapshot differs from DRAFT edits.
  hasUnpublishedChanges Boolean @default(false)

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  publishedAt DateTime?

  images          ProductImage[]
  models          ProductModel[]
  assetPackage    ProductAssetPackage?
  publishJobs     PublishJob[]
  analyticsEvents AnalyticsEvent[]
  auditLogs       AuditLog[]        @relation("AuditProduct")

  @@index([sellerId])
  @@index([visibility])
  @@index([categoryId])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  url        String
  storageKey String
  isPrimary  Boolean  @default(false)
  sortOrder  Int      @default(0)
  width      Int?
  height     Int?
  sizeBytes  Int?

  createdAt DateTime @default(now())

  @@index([productId])
}

model ProductAssetPackage {
  id         String   @id @default(cuid())
  productId  String   @unique
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  storageKey String
  sizeBytes  Int
  version    Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ProductModel {
  id             String   @id @default(cuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  kind           String   // "GLB" | "GLTF" | "USDZ"
  url            String
  storageKey     String
  sizeBytes      Int?
  posterImageUrl String?

  createdAt DateTime @default(now())

  @@index([productId])
}

// ----------------------------------------------------------------
// Subscriptions
// ----------------------------------------------------------------

model SubscriptionPlanCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)

  plans SubscriptionPlan[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model SubscriptionPlan {
  id            String   @id @default(cuid())
  name          String
  durationDays  Int
  price         Float
  discountPct   Float?
  features      String?
  productLimit  Int?
  storageLimitMb Int?
  // Monthly public data-transfer allowance in GB. Null means unlimited.
  trafficLimitGb Int?
  categoryId    String?
  category      SubscriptionPlanCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  isPublic      Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]

  @@index([categoryId, sortOrder])
  @@index([isActive, sortOrder])
}

model Subscription {
  id        String           @id @default(cuid())
  sellerId  String
  seller    Seller           @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  planId    String
  plan      SubscriptionPlan @relation(fields: [planId], references: [id])

  status    String   @default("PENDING")
  startDate DateTime?
  endDate   DateTime?

  activatedById String?
  activatedBy   User? @relation("ActivatedByAdmin", fields: [activatedById], references: [id])

  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sellerId, status])
}

// ----------------------------------------------------------------
// Publishing pipeline
// ----------------------------------------------------------------

model TrafficBundle {
  id         String   @id @default(cuid())
  name       String
  gigabytes  Int
  priceToman Int
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)

  purchases TrafficPurchase[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model TrafficUsage {
  id          String   @id @default(cuid())
  sellerId    String
  seller      Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  periodStart DateTime
  periodEnd   DateTime
  servedBytes BigInt   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sellerId, periodStart])
  @@index([sellerId, periodEnd])
}

model TrafficPurchase {
  id               String        @id @default(cuid())
  sellerId         String
  seller           Seller        @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  bundleId         String
  bundle           TrafficBundle @relation(fields: [bundleId], references: [id])
  periodStart      DateTime
  periodEnd        DateTime
  gigabytes        Int
  priceToman       Int
  status           String        @default("PENDING")
  paymentReference String?
  notes            String?
  requestedAt      DateTime      @default(now())
  approvedAt       DateTime?
  approvedById     String?
  approvedBy       User?         @relation("TrafficPurchaseApprovedBy", fields: [approvedById], references: [id])
  rejectedAt       DateTime?

  @@index([sellerId, periodStart, status])
  @@index([status, requestedAt])
}

model PublishJob {
  id          String   @id @default(cuid())
  sellerId    String
  seller      Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  productId   String?
  product     Product? @relation(fields: [productId], references: [id])

  triggeredById String
  triggeredBy   User @relation("TriggeredByUser", fields: [triggeredById], references: [id])

  status       String  @default("QUEUED")
  // Exact intent of this job: PUBLISH, UNPUBLISH, or REBUILD.
  // This is persisted so the UI and audit trail never have to infer intent
  // from the product visibility alone.
  operation    String  @default("PUBLISH")
  commitSha    String?
  errorMessage String?

  requestedAt DateTime @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?

  logs PublishLog[]

  @@index([sellerId])
  @@index([status])
}

model PublishLog {
  id           String     @id @default(cuid())
  publishJobId String
  publishJob   PublishJob @relation(fields: [publishJobId], references: [id], onDelete: Cascade)

  message   String
  level     String   @default("info")
  createdAt DateTime @default(now())

  @@index([publishJobId])
}

// ----------------------------------------------------------------
// Analytics & Audit
// ----------------------------------------------------------------

model AnalyticsEvent {
  id        String   @id @default(cuid())
  type      String
  sellerId  String?
  seller    Seller?  @relation(fields: [sellerId], references: [id])
  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  metadata  String?
  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@index([sellerId])
  @@index([productId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id])

  sellerId  String?
  seller    Seller?  @relation("AuditSeller", fields: [sellerId], references: [id])

  productId String?
  product   Product? @relation("AuditProduct", fields: [productId], references: [id])

  action    String
  entity    String
  entityId  String?
  ipAddress String?
  metadata  String?

  createdAt DateTime @default(now())

  @@index([action, createdAt])
  @@index([actorId])
}

// ----------------------------------------------------------------
// Platform-wide settings / white-label branding
// ----------------------------------------------------------------

model PlatformSetting {
  id            String   @id @default("singleton")

  platformName  String   @default("پلتفرم نمایشگاه محصول")
  logoUrl       String?
  faviconUrl    String?

  colorPrimary    String @default("#3730A3")
  colorSecondary  String @default("#7C3AED")
  colorAccent     String @default("#06B6D4")
  colorBackground String @default("#F8FAFC")
  colorText       String @default("#1E293B")
  fontFamily      String @default("Vazirmatn")

  socialLinks   String?
  contactEmail  String?
  contactPhone  String?

  githubOwner      String?
  githubRepository String?
  githubBranch     String   @default("main")

  // NOTE: GitHub token is NEVER stored here.
  // It lives only in server environment variables (GITHUB_TOKEN).

  updatedAt DateTime @updatedAt
}
