# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.
# ============================================================

NODE_ENV=development
PORT=4000

# --- Database -------------------------------------------------
# Local dev (SQLite, zero setup):
DATABASE_URL="file:./dev.db"
# Production (Postgres) example:
# DATABASE_URL="postgresql://user:password@host:5432/platform?schema=public"

# --- Sessions ---------------------------------------------------
# Generate with: openssl rand -hex 32
SESSION_SECRET="replace-with-a-random-64-char-hex-string"

# --- GitHub publishing layer (server-side ONLY, never exposed to frontend) --
# Use a fine-grained personal access token or GitHub App with the minimum
# scope needed: Contents (read/write) on the single target repository.
GITHUB_TOKEN=
GITHUB_OWNER=your-github-username-or-org
GITHUB_REPOSITORY=your-public-site-repo
GITHUB_BRANCH=main

# --- URLs -----------------------------------------------------
PUBLIC_SITE_URL=https://your-username.github.io/your-public-site-repo
API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# --- Storage abstraction (Phase 2) -----------------------------
# "local" for development; switch to "s3" (or an S3-compatible provider)
# in production without changing application code.
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# --- Rate limiting ----------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=10

# --- Seed script (first SUPER_ADMIN account) --------------------
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
